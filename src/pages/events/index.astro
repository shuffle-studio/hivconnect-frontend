---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/ui/Header.astro';
import Footer from '../../components/ui/Footer.astro';
import EventsCalendar from '../../components/events/EventsCalendar';
import { fetchUpcomingEvents, fetchPastEvents } from '../../lib/api';
import type { Event } from '../../lib/api';

const title = 'Events & Calendar';
const description = 'Upcoming events, meetings, and activities from the HIV Connect Central NJ community.';

// Fetch upcoming and past events
let upcomingEvents: Event[] = [];
let pastEvents: Event[] = [];
let error: string | null = null;

try {
  upcomingEvents = await fetchUpcomingEvents();
  pastEvents = await fetchPastEvents();
} catch (e) {
  error = e instanceof Error ? e.message : 'Failed to load events';
  console.error('Error fetching events:', e);
}

// The calendar island handles upcoming and past together — the date-range
// filter is what separates them now, rather than two fixed sections.
const allEvents = [...upcomingEvents, ...pastEvents];

// Pass build time explicitly so the prerendered markup and the hydrated island
// agree on what "today" is.
const today = new Date().toISOString();
---

<BaseLayout title={title} description={description}>
  <Header />
  <main>
    <div class="min-h-screen bg-stone-50 py-12">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="mb-10 text-center">
          <h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl mb-4">
            Events & Calendar
          </h1>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            Join us for upcoming meetings, health fairs, support groups, and community events
          </p>
        </div>

        {error && (
          <div class="mb-8 rounded-lg bg-primary-50 p-4 text-primary-800">
            <p class="font-medium">Error loading events</p>
            <p class="text-sm">{error}</p>
          </div>
        )}

        {!error && allEvents.length === 0 && (
          <div class="text-center py-12">
            <p class="text-gray-600 text-lg">No events currently scheduled. Check back soon!</p>
          </div>
        )}

        {!error && allEvents.length > 0 && (
          <EventsCalendar client:load events={allEvents} today={today} />
        )}

        <!--
          Conversion CTA. Static markup, not inside the island, so it renders
          even if the calendar fails to hydrate. Copy is lifted from the site's
          own FAQ answer on joining, so the two pages say the same thing.
        -->
        <section class="mt-14 rounded-lg bg-primary-700 px-6 py-10 sm:px-10 sm:py-12">
          <div class="mx-auto max-w-3xl text-center">
            <h2 class="text-2xl font-bold text-white sm:text-3xl">
              Want a say in how HIV services are delivered here?
            </h2>
            <p class="mt-3 text-lg text-primary-100">
              The Planning Council welcomes new members — especially people living with
              HIV/AIDS. Members serve two-year terms and help decide how funding is used
              across Middlesex, Somerset and Hunterdon counties.
            </p>
            <div class="mt-7 flex flex-col items-center justify-center gap-3 sm:flex-row">
              <a
                href="/planning-council-application"
                class="inline-block w-full rounded-md bg-white px-6 py-3 font-semibold text-primary-700 shadow-sm transition-colors hover:bg-primary-50 sm:w-auto"
              >
                Join the Planning Council
              </a>
              <a
                href="/contact"
                class="inline-block w-full rounded-md border border-primary-300 px-6 py-3 font-semibold text-white transition-colors hover:bg-primary-600 sm:w-auto"
              >
                Ask us a question
              </a>
            </div>
            <p class="mt-5 text-sm text-primary-200">
              Not ready to join? Everyone is welcome at our meetings — no membership required.
            </p>
          </div>
        </section>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
